# Copy to .env to override the defaults (Bun loads .env automatically).

# Port of the production server (bun run start).
PORT=3000

# SQLite database file. Keep it on persistent storage and back it up.
DATABASE_PATH=data/rateio.sqlite

# Password that unlocks the app (optional). Another one can be set in
# Configurações → Senha de acesso; either one works. Empty means no password.
# It is also the secret of GET /api/exportar (backup for scripts), which is
# off while this is empty. Make it long.
APP_PASSWORD=

# Folder with the CSV export of the old Access app (T_Usuarios.csv,
# T_Fatura.csv, T_Consumo.csv). When set, an empty database is filled with it
# on start. Keep the files out of the repository (legacy/ is git-ignored).
LEGACY_DATA_PATH=
