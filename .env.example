# Copy to .env to override the defaults (Bun loads .env automatically).

# Port of the production server (bun run start).
PORT=3000

# SQLite database file. Keep it on persistent storage and back it up.
DATABASE_PATH=data/rateio.sqlite

# Password that unlocks the app (optional). Another one can be set in
# Configurações → Senha de acesso; either one works. Empty means no password.
# Only browsers unlocked with this one can import data and wipe it all in
# Configurações. It is also the secret of GET /api/exportar (backup for
# scripts), which is off while this is empty. Make it long.
APP_PASSWORD=
